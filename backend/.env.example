# Copy to .env and fill in. .env is gitignored and must never be committed.
# NO REAL VALUE BELONGS IN THIS FILE.

# ---------------------------------------------------------------------------
# SAFETY. Leave these alone unless you have read docs/PHASE_GATES.md in full.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
CURRENT_PHASE=PHASE_1

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
BIND_HOST=127.0.0.1
BIND_PORT=8000

# ---------------------------------------------------------------------------
# Database (local PostgreSQL; no hosted/paid database)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://beroapp:CHANGE_ME@127.0.0.1:5432/beroapp

# ---------------------------------------------------------------------------
# API auth. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# The server refuses to start with an empty API_KEY unless ALLOW_INSECURE_LOCAL=true.
# ---------------------------------------------------------------------------
API_KEY=
OPERATOR_API_KEY=
ALLOW_INSECURE_LOCAL=false
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------------------------------------------------------------------------
# Worker cadence (seconds)
# ---------------------------------------------------------------------------
DISCOVERY_INTERVAL_S=900
SNAPSHOT_INTERVAL_S=60
PREDICTION_INTERVAL_S=300
RESOLUTION_INTERVAL_S=1800
METRICS_INTERVAL_S=600
DATA_STALENESS_S=300

# ---------------------------------------------------------------------------
# Paper trading. VIRTUAL money only. Never real funds.
# ---------------------------------------------------------------------------
VIRTUAL_INITIAL_CAPITAL=10000

# ---------------------------------------------------------------------------
# Hard risk limits (percent of equity)
# ---------------------------------------------------------------------------
MAX_POSITION_SIZE_PERCENT=2.0
MAX_MARKET_EXPOSURE_PERCENT=5.0
MAX_PORTFOLIO_EXPOSURE_PERCENT=50.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_DRAWDOWN_PERCENT=20.0
MAX_CORRELATED_EXPOSURE_PERCENT=15.0
MIN_LIQUIDITY=5000
MAX_SPREAD=0.05
MAX_ALLOWED_SLIPPAGE=0.02

# ---------------------------------------------------------------------------
# Optional evidence-source keys. Absent -> that connector reports DISABLED.
# ---------------------------------------------------------------------------
FRED_API_KEY=
# SEC requires a descriptive User-Agent with contact details.
SEC_USER_AGENT=

# ---------------------------------------------------------------------------
# Optional LLM enrichment. The system is fully functional with this off.
# An LLM can never produce a probability that reaches the edge engine.
# ---------------------------------------------------------------------------
LLM_ENABLED=false
LLM_API_KEY=
