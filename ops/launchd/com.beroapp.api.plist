<?xml version="1.0" encoding="UTF-8"?>
<!--
  API: read-only HTTP surface for the dashboard.

  Bound to 127.0.0.1 deliberately. This service has authentication and rate
  limiting but has not been hardened for exposure beyond the local host; see
  docs/SECURITY.md "Known limitations".

  Replace __HOME__ with your home directory before installing.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beroapp.api</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/beroapp/backend/.venv/bin/uvicorn</string>
        <string>app.api.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/beroapp/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>LOG_LEVEL</key>
        <string>INFO</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/beroapp/logs/api.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/beroapp/logs/api.error.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
